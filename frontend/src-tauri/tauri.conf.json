{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperTrans",
  "version": "0.1.0",
  "identifier": "com.papertrans.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperTrans",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#faf9fe"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
