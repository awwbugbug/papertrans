{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperTrans",
  "version": "0.1.1",
  "identifier": "com.papertrans.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperTrans",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#faf9fe"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/papertrans-backend"],
    "resources": {
      "../../models/paddleocr/PP-OCRv6_medium_det_infer": "models/paddleocr/PP-OCRv6_medium_det_infer",
      "../../models/paddleocr/PP-OCRv6_medium_rec_infer": "models/paddleocr/PP-OCRv6_medium_rec_infer"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
